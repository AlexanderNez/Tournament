
Admin · HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>K&S FN Tournament — Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#1A0F22; --panel:#241531; --line:#3E2350;
    --storm:#B45CF7; --pink:#FF5DA8; --orange:#FF7A29; --gold:#FFC93C;
    --text:#F5ECF9; --muted:#A78BB8;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; min-height:100vh; }
  .wrap{ max-width:1100px; margin:0 auto; padding:28px 20px 80px; }
  h1{ font-family:'Rajdhani',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin:0 0 4px; }
  h1 span{ color:var(--gold); }
  .sub{ color:var(--muted); font-size:13px; margin:0 0 28px; }
 
  /* login */
  #login-screen{ max-width:360px; margin:80px auto; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:32px; }
  #login-screen h2{ font-family:'Rajdhani',sans-serif; margin:0 0 16px; }
  #login-screen input{ width:100%; padding:10px 12px; border-radius:8px; border:1px solid var(--line); background:#150E1F; color:var(--text); font-size:14px; margin-bottom:12px; }
  #login-screen button, .btn{ background:var(--gold); color:#1A0F22; border:none; padding:10px 18px; border-radius:8px; font-weight:700; font-size:14px; cursor:pointer; font-family:'Inter',sans-serif; }
  #login-error{ color:var(--orange); font-size:13px; margin-top:8px; min-height:18px; }
 
  #app{ display:none; }
 
  .tabs{ display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
  .tab-btn{ background:var(--panel); border:1px solid var(--line); color:var(--muted); padding:8px 16px; border-radius:8px; cursor:pointer; font-size:13px; font-family:'Inter',sans-serif; }
  .tab-btn.active{ background:var(--storm); color:#fff; border-color:var(--storm); }
  .tab-panel{ display:none; }
  .tab-panel.active{ display:block; }
 
  table{ width:100%; border-collapse:collapse; background:var(--panel); border-radius:10px; overflow:hidden; margin-bottom:16px; }
  th{ background:#2E1B3D; color:var(--gold); font-size:11px; text-transform:uppercase; letter-spacing:0.5px; padding:8px 6px; text-align:left; position:sticky; top:0; }
  td{ padding:5px 6px; border-bottom:1px solid var(--line); font-size:13px; }
  input, select{ width:100%; padding:6px 7px; border-radius:6px; border:1px solid var(--line); background:#150E1F; color:var(--text); font-size:13px; font-family:'JetBrains Mono', monospace; }
  input[type=text]{ font-family:'Inter',sans-serif; }
  .table-scroll{ max-height:520px; overflow:auto; border-radius:10px; }
 
  .settings-row{ display:flex; align-items:center; gap:12px; margin-bottom:14px; }
  .settings-row label{ min-width:160px; color:var(--muted); font-size:13px; }
  .settings-row input{ width:100px; }
 
  .game-controls{ display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
  .game-controls select{ width:auto; padding:8px 12px; }
 
  #save-bar{ position:sticky; bottom:0; background:var(--bg); padding:14px 0; margin-top:16px; display:flex; align-items:center; gap:14px; border-top:1px solid var(--line); }
  #save-status{ font-size:13px; color:var(--muted); }
 
  .placement-scale-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(90px,1fr)); gap:8px; margin-bottom:20px; }
  .placement-scale-grid div{ background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:8px; text-align:center; }
  .placement-scale-grid label{ display:block; font-size:11px; color:var(--muted); margin-bottom:4px; }
</style>
</head>
<body>
<div class="wrap">
 
  <div id="login-screen">
    <h2>K&S <span style="color:var(--gold)">FN</span> Admin</h2>
    <input type="password" id="password-input" placeholder="Admin password" autocomplete="current-password">
    <button onclick="login()">Log In</button>
    <div id="login-error"></div>
  </div>
 
  <div id="app">
    <h1>K&S <span>FN</span> Tournament — Admin</h1>
    <p class="sub">Changes save to the tournament backend and appear on the public site within a refresh cycle.</p>
 
    <div class="tabs">
      <button class="tab-btn active" data-tab="teams">Teams</button>
      <button class="tab-btn" data-tab="games">Game Stats</button>
      <button class="tab-btn" data-tab="settings">Scoring Settings</button>
    </div>
 
    <div class="tab-panel active" id="tab-teams">
      <div class="table-scroll">
        <table>
          <thead><tr><th>Team Name</th><th>Player 1</th><th>P1 Twitch</th><th>Player 2</th><th>P2 Twitch</th><th>Approved By</th></tr></thead>
          <tbody id="teams-body"></tbody>
        </table>
      </div>
    </div>
 
    <div class="tab-panel" id="tab-games">
      <div class="game-controls">
        <label style="color:var(--muted); font-size:13px;">Game:</label>
        <select id="game-select"></select>
        <button class="btn" onclick="addGame()">+ Add New Game</button>
        <button class="btn" style="background:var(--orange); color:#1A0F22;" onclick="deleteCurrentGame()">Delete This Game</button>
      </div>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Team</th><th>Placement</th><th>P1 Kills</th><th>P1 Assists</th><th>P1 Acc%</th><th>P1 HS</th><th>P2 Kills</th><th>P2 Assists</th><th>P2 Acc%</th><th>P2 HS</th></tr></thead>
          <tbody id="games-body"></tbody>
        </table>
      </div>
    </div>
 
    <div class="tab-panel" id="tab-settings">
      <div class="settings-row">
        <label>Points per Kill</label>
        <input type="number" id="points-per-kill" step="0.5">
      </div>
      <h3 style="font-family:'Rajdhani',sans-serif; margin:20px 0 8px;">Placement → Points Scale</h3>
      <div class="placement-scale-grid" id="placement-scale-grid"></div>
    </div>
 
    <div id="save-bar">
      <button class="btn" onclick="saveAll()">Save All Changes</button>
      <span id="save-status"></span>
    </div>
  </div>
 
</div>
 
<script>
/* ============================================================
   CONFIG — same Worker URL as CONFIG.API_URL in index.html
   ============================================================ */
const API_URL = "PASTE_YOUR_WORKER_URL_HERE"; // e.g. https://kns-tournament.yourname.workers.dev
 
let token = sessionStorage.getItem("kns_admin_token") || null;
let data = null; // { settings, teams, games }
let currentGameIndex = 0;
 
async function login(){
  const password = document.getElementById("password-input").value;
  const errEl = document.getElementById("login-error");
  errEl.textContent = "";
  try{
    const res = await fetch(API_URL + "/admin/login", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ password }),
    });
    if (!res.ok){ errEl.textContent = "Wrong password."; return; }
    const body = await res.json();
    token = body.token;
    sessionStorage.setItem("kns_admin_token", token);
    await boot();
  } catch(err){
    console.error(err);
    errEl.textContent = "Couldn't reach the server.";
  }
}
 
async function fetchData(){
  const res = await fetch(API_URL + "/admin/data", { headers: { Authorization: "Bearer " + token } });
  if (res.status === 401){ sessionStorage.removeItem("kns_admin_token"); token = null; showLogin(); return null; }
  if (!res.ok) throw new Error("failed to load data: " + res.status);
  return await res.json();
}
 
function showLogin(){
  document.getElementById("login-screen").style.display = "block";
  document.getElementById("app").style.display = "none";
}
function showApp(){
  document.getElementById("login-screen").style.display = "none";
  document.getElementById("app").style.display = "block";
}
 
async function boot(){
  if (!token){ showLogin(); return; }
  const loaded = await fetchData();
  if (!loaded) return;
  data = loaded;
  showApp();
  renderTeams();
  renderGameSelect();
  renderGameStats();
  renderSettings();
}
 
/* ---------------- Teams tab ---------------- */
function renderTeams(){
  const tbody = document.getElementById("teams-body");
  tbody.innerHTML = "";
  data.teams.forEach((t, idx) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><input type="text" value="${esc(t.name)}" onchange="data.teams[${idx}].name=this.value"></td>
      <td><input type="text" value="${esc(t.player1)}" onchange="data.teams[${idx}].player1=this.value"></td>
      <td><input type="text" value="${esc(t.player1Twitch)}" onchange="data.teams[${idx}].player1Twitch=this.value"></td>
      <td><input type="text" value="${esc(t.player2)}" onchange="data.teams[${idx}].player2=this.value"></td>
      <td><input type="text" value="${esc(t.player2Twitch)}" onchange="data.teams[${idx}].player2Twitch=this.value"></td>
      <td><input type="text" value="${esc(t.approvedBy)}" onchange="data.teams[${idx}].approvedBy=this.value"></td>
    `;
    tbody.appendChild(tr);
  });
}
 
/* ---------------- Games tab ---------------- */
function renderGameSelect(){
  const sel = document.getElementById("game-select");
  sel.innerHTML = "";
  data.games.forEach((g, idx) => {
    const opt = document.createElement("option");
    opt.value = idx; opt.textContent = "Game " + g.gameNumber;
    sel.appendChild(opt);
  });
  if (currentGameIndex >= data.games.length) currentGameIndex = Math.max(0, data.games.length - 1);
  sel.value = currentGameIndex;
  sel.onchange = () => { currentGameIndex = Number(sel.value); renderGameStats(); };
}
 
function addGame(){
  const nextNum = data.games.length ? Math.max(...data.games.map(g => g.gameNumber)) + 1 : 1;
  data.games.push({ gameNumber: nextNum, placements: {}, stats: {} });
  currentGameIndex = data.games.length - 1;
  renderGameSelect();
  renderGameStats();
}
 
function deleteCurrentGame(){
  if (!data.games.length) return;
  if (!confirm("Delete Game " + data.games[currentGameIndex].gameNumber + "? This can't be undone until you save, but once saved it's gone.")) return;
  data.games.splice(currentGameIndex, 1);
  currentGameIndex = 0;
  renderGameSelect();
  renderGameStats();
}
 
function renderGameStats(){
  const tbody = document.getElementById("games-body");
  tbody.innerHTML = "";
  if (!data.games.length){
    tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; color:var(--muted); padding:20px;">No games yet — click "+ Add New Game" to start.</td></tr>`;
    return;
  }
  const game = data.games[currentGameIndex];
  if (!game.placements) game.placements = {};
  if (!game.stats) game.stats = {};
 
  data.teams.forEach((t) => {
    if (!game.stats[t.id]) game.stats[t.id] = { p1: {}, p2: {} };
    const s = game.stats[t.id];
    const placement = game.placements[t.id] ?? "";
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td style="font-weight:600;">${esc(t.name)}</td>
      <td><input type="number" min="1" value="${placement}" onchange="setPlacement(${t.id}, this.value)"></td>
      <td><input type="number" min="0" value="${s.p1.kills ?? ''}" onchange="setStat(${t.id},'p1','kills',this.value)"></td>
      <td><input type="number" min="0" value="${s.p1.assists ?? ''}" onchange="setStat(${t.id},'p1','assists',this.value)"></td>
      <td><input type="number" min="0" max="100" value="${s.p1.accuracy ?? ''}" onchange="setStat(${t.id},'p1','accuracy',this.value)"></td>
      <td><input type="number" min="0" value="${s.p1.headshots ?? ''}" onchange="setStat(${t.id},'p1','headshots',this.value)"></td>
      <td><input type="number" min="0" value="${s.p2.kills ?? ''}" onchange="setStat(${t.id},'p2','kills',this.value)"></td>
      <td><input type="number" min="0" value="${s.p2.assists ?? ''}" onchange="setStat(${t.id},'p2','assists',this.value)"></td>
      <td><input type="number" min="0" max="100" value="${s.p2.accuracy ?? ''}" onchange="setStat(${t.id},'p2','accuracy',this.value)"></td>
      <td><input type="number" min="0" value="${s.p2.headshots ?? ''}" onchange="setStat(${t.id},'p2','headshots',this.value)"></td>
    `;
    tbody.appendChild(tr);
  });
}
 
function setPlacement(teamId, value){
  const game = data.games[currentGameIndex];
  game.placements[teamId] = value === "" ? null : Number(value);
}
function setStat(teamId, slot, field, value){
  const game = data.games[currentGameIndex];
  game.stats[teamId][slot][field] = value === "" ? null : Number(value);
}
 
/* ---------------- Settings tab ---------------- */
function renderSettings(){
  document.getElementById("points-per-kill").value = data.settings.pointsPerKill;
  document.getElementById("points-per-kill").onchange = (e) => { data.settings.pointsPerKill = Number(e.target.value); };
 
  const grid = document.getElementById("placement-scale-grid");
  grid.innerHTML = "";
  const placements = Object.keys(data.settings.placementPoints).sort((a,b) => Number(a)-Number(b));
  placements.forEach((p) => {
    const div = document.createElement("div");
    div.innerHTML = `<label>${p===placements[0] ? "1st" : "#" + p}</label><input type="number" value="${data.settings.placementPoints[p]}" onchange="data.settings.placementPoints['${p}']=Number(this.value)">`;
    grid.appendChild(div);
  });
}
 
/* ---------------- Save ---------------- */
async function saveAll(){
  const statusEl = document.getElementById("save-status");
  statusEl.textContent = "Saving…";
  try{
    const res = await fetch(API_URL + "/admin/save", {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
      body: JSON.stringify(data),
    });
    if (res.status === 401){ statusEl.textContent = "Session expired — log in again."; sessionStorage.removeItem("kns_admin_token"); token = null; showLogin(); return; }
    if (!res.ok) throw new Error("save failed: " + res.status);
    statusEl.textContent = "Saved " + new Date().toLocaleTimeString();
  } catch(err){
    console.error(err);
    statusEl.textContent = "Couldn't save — check your connection and try again.";
  }
}
 
/* ---------------- tabs + helpers ---------------- */
document.querySelectorAll(".tab-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById("tab-" + btn.dataset.tab).classList.add("active");
  });
});
 
function esc(str){
  return String(str ?? "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
}
 
boot();
</script>
</body>
</html>
